{
  "name": "chat-manager",
  "productName": "Chat Manager",
  "version": "1.4.0",
  "description": "WhatsApp, Telegram and Microsoft Teams accounts side by side in one desktop app for Mac and Windows",
  "license": "MIT",
  "author": "Yehia Elassouli",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.local.chatmanager",
    "productName": "Chat Manager",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "artifactName": "Chat-Manager-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Chat Manager needs the microphone for WhatsApp, Telegram and Teams calls.",
        "NSCameraUsageDescription": "Chat Manager needs the camera for WhatsApp, Telegram and Teams video calls."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Chat-Manager-Setup-${version}.${ext}"
    },
    "directories": {
      "buildResources": "build"
    }
  }
}
